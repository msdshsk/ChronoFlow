{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChronoFlow",
  "version": "0.1.0",
  "identifier": "com.chronoflow.calendar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "ChronoFlow",
        "width": 1240,
        "height": 1040,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
